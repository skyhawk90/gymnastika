---
import { getCollection, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { date } from "../../data";
export async function getStaticPaths() {
  return (await getCollection("clanky", ({ data }) => !data.draft)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<"clanky">;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const og = entry.data.cover
  ? await getImage({ src: entry.data.cover, width: 1200, format: "jpg" })
  : undefined;
---

<Base title={entry.data.title} description={entry.data.summary} image={og?.src} article
  ><section>
    <article class="wrap prose">
      <a class="more" href="/clanky/">← Všechny články</a><h1 class="page-title">
        {entry.data.title}
      </h1><div class="meta">
        <time datetime={entry.data.date.toISOString()}>{date(entry.data.date)}</time><span
          >{entry.data.place}</span
        ><span>{entry.data.medals}</span>
      </div>{
        entry.data.cover && (
          <Image
            class="article-cover"
            src={entry.data.cover}
            alt={entry.data.coverAlt || entry.data.title}
            width={1200}
            widths={[400, 800, 1200]}
            sizes="(max-width: 800px) 92vw, 780px"
          />
        )
      }<Content />
    </article>
  </section></Base
>
