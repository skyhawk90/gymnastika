---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { date } from "../data";
interface Props {
  entry: CollectionEntry<"clanky">;
}
const { entry: a } = Astro.props;
---

<article class:list={["news-feature", { "no-cover": !a.data.cover }]}>
  <a href={`/clanky/${a.id}/`}>
    {
      a.data.cover && (
        <div class="ph">
          <Image
            src={a.data.cover}
            alt={a.data.coverAlt || a.data.title}
            width={800}
            height={450}
            widths={[400, 800]}
            sizes="(max-width: 860px) 92vw, 640px"
            loading="lazy"
          />
        </div>
      )
    }
    <div class="body">
      <div class="meta">
        <time datetime={a.data.date.toISOString()}>{date(a.data.date)}</time>
        {a.data.place && <span>{a.data.place}</span>}
        {a.data.medals && <span class="medal">{a.data.medals}</span>}
      </div>
      <h3>{a.data.title}</h3>
      <p>{a.data.summary}</p>
    </div>
  </a>
</article>
